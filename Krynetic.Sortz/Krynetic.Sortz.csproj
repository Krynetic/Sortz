<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Krynetic.Sortz</RootNamespace>
    <AssemblyName>Krynetic.Sortz</AssemblyName>
    <OutputType>Library</OutputType>
    <TargetFrameworks>netstandard2.1;net9.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>

    <IsPackable>true</IsPackable>
    <PackageId>Krynetic.Sortz</PackageId>
    <Version>0.1.0</Version>
    <Authors>Krynetic</Authors>
    <Company>Krynetic</Company>
    <Description>High-performance, in-place sorting for .NET lists and spans with SIMD-accelerated primitive sorting and comparer-aware fallbacks.</Description>
    <PackageTags>sorting;sort;performance;simd;span;algorithms</PackageTags>
    <PackageProjectUrl>https://github.com/Krynetic/Sortz</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Krynetic/Sortz.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <Compile Remove="Sortz.cs;Sortz.Primitives.cs;SimdSort.cs;PrimitiveSimdSort.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.1'">
    <Compile Remove="Sortz.Portable.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
