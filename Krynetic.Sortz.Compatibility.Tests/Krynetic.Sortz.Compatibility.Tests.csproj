<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Krynetic.Sortz.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <DefineConstants>$(DefineConstants);SORTZ_NETSTANDARD_COMPAT</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1" PrivateAssets="all" />
    <Compile Include="../Krynetic.Sortz.Tests/*.cs"
             Exclude="../Krynetic.Sortz.Tests/SortPerformanceTests.cs"
             Link="%(Filename)%(Extension)" />
    <!-- Deliberately reference the portable asset, not the nearest net9.0 asset. -->
    <Reference Include="Krynetic.Sortz">
      <HintPath>../Krynetic.Sortz/bin/$(Configuration)/netstandard2.1/Krynetic.Sortz.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
